NUXT_PUBLIC_APP_ENV="development"

NUXT_PUBLIC_SHOPWARE_DEV_STORE_FRONT_URL="http://localhost:3000"
NUXT_PUBLIC_STORE_URL="http://localhost:3000"

NUXT_PUBLIC_SHOPWARE_ENDPOINT="https://shopware.shopbite.de/store-api"
NUXT_PUBLIC_SHOPWARE_ACCESS_TOKEN="TOKEN"
NUXT_PUBLIC_SHOPWARE_COUNTRY_ID=019a17a0f67b706a8ec9ead3059e12ba

NUXT_PUBLIC_SHOP_BITE_FEATURE_MULTI_CHANNEL=false
NUXT_PUBLIC_SHOP_BITE_FEATURE_SECURE_KEY=

OPENAPI_ACCESS_KEY=key
OPENAPI_JSON_URL="https://shopware.shopbite.net"

NUXT_GEOAPIFY_API_KEY=

NUXT_PUBLIC_SCRIPTS_MATOMO_ANALYTICS_MATOMO_URL=
NUXT_PUBLIC_SCRIPTS_MATOMO_ANALYTICS_SITE_ID=

# SEO (NUXT_PUBLIC_STORE_URL above is the base of canonical URLs and the sitemap)
NUXT_PUBLIC_SITE_TITLE_TEMPLATE="%s | %siteName – Online bestellen"
NUXT_PUBLIC_SITE_OG_IMAGE="/card.png"
NUXT_PUBLIC_SITE_CUISINE=
NUXT_PUBLIC_SITE_ADDRESS_CITY=

# Footer contact block (empty values are hidden)
NUXT_PUBLIC_SITE_ADDRESS_STREET=
NUXT_PUBLIC_SITE_ADDRESS_POSTAL_CODE=
NUXT_PUBLIC_SITE_TELEPHONE=
NUXT_PUBLIC_SITE_GOOGLE_BUSINESS_PROFILE_URL=

NUXT_STORE_NAME="ShopBite"
STORE_DESCRIPTION="Reduziere deine Kosten und steigere deinen Umsatz"