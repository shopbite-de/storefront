NUXT_PUBLIC_APP_ENV="development"

NUXT_PUBLIC_SHOPWARE_DEV_STORE_FRONT_URL="http://localhost:3000"
NUXT_PUBLIC_STORE_URL="http://localhost:3000"

NUXT_PUBLIC_SHOPWARE_ENDPOINT="https://shopware.shopbite.de/store-api"
NUXT_PUBLIC_SHOPWARE_ACCESS_TOKEN="TOKEN"
NUXT_PUBLIC_SHOPWARE_COUNTRY_ID=019a17a0f67b706a8ec9ead3059e12ba

NUXT_PUBLIC_SHOP_BITE_FEATURE_MULTI_CHANNEL=false
NUXT_PUBLIC_SHOP_BITE_FEATURE_SECURE_KEY=
NUXT_PUBLIC_SHOP_BITE_FEATURE_CONTACT_FORM=false
# Demo shops: notice above the header that orders are not fulfilled
NUXT_PUBLIC_SHOP_BITE_FEATURE_DEMO_BANNER=false
# Optional Geoapify bounding box lon1,lat1,lon2,lat2 for the address
# suggestions in the checkout (empty = no filter)
NUXT_PUBLIC_SHOP_BITE_ADDRESS_AUTOCOMPLETE_BOUNDING_BOX=

OPENAPI_ACCESS_KEY=key
OPENAPI_JSON_URL="https://shopware.shopbite.net"

NUXT_GEOAPIFY_API_KEY=
# Per-IP limit of address lookups that reach Geoapify (token bucket in
# memory; capacity 0 = off, e.g. when the reverse proxy limits the route).
# The client IP is read from X-Forwarded-For.
NUXT_ADDRESS_AUTOCOMPLETE_RATE_LIMIT_CAPACITY=20
NUXT_ADDRESS_AUTOCOMPLETE_RATE_LIMIT_REFILL_PER_MINUTE=20

# Matomo loads only when both values are set
NUXT_PUBLIC_SCRIPTS_MATOMO_ANALYTICS_MATOMO_URL=
NUXT_PUBLIC_SCRIPTS_MATOMO_ANALYTICS_SITE_ID=

# SEO (NUXT_PUBLIC_STORE_URL above is the base of canonical URLs and the sitemap)
NUXT_PUBLIC_SITE_TITLE_TEMPLATE="%s | %siteName – Online bestellen"
NUXT_PUBLIC_SITE_OG_IMAGE="/card.png"
NUXT_PUBLIC_SITE_CUISINE=
NUXT_PUBLIC_SITE_ADDRESS_CITY=

# Footer contact block (empty values are hidden)
NUXT_PUBLIC_SITE_ADDRESS_STREET=
NUXT_PUBLIC_SITE_ADDRESS_POSTAL_CODE=
NUXT_PUBLIC_SITE_ADDRESS_COUNTRY=DE
NUXT_PUBLIC_SITE_TELEPHONE=
NUXT_PUBLIC_SITE_GOOGLE_BUSINESS_PROFILE_URL=
# Restaurant schema (schema.org), e.g. "€€"
NUXT_PUBLIC_SITE_PRICE_RANGE=
# Comma-separated, e.g. "12345 Musterstadt, 12346 Beispieldorf"
NUXT_PUBLIC_SITE_DELIVERY_AREAS=
NUXT_PUBLIC_SITE_GEO_LATITUDE=
NUXT_PUBLIC_SITE_GEO_LONGITUDE=
# true, false or a text such as "Nur telefonisch"
NUXT_PUBLIC_SITE_ACCEPTS_RESERVATIONS=
# AI crawlers in robots.txt: search/assistants and model training (#403)
NUXT_AI_CRAWLERS_SEARCH=true
NUXT_AI_CRAWLERS_TRAINING=true

NUXT_STORE_NAME="ShopBite"
STORE_DESCRIPTION="Reduziere deine Kosten und steigere deinen Umsatz"
# Secret of POST /api/_cache/purge, the backoffice empties the Store API caches after menu changes (empty = off)
NUXT_CACHE_PURGE_SECRET=

# Bound of the in-memory server cache (LRU); max entries 0 = unbounded
NUXT_CACHE_STORAGE_MAX_ENTRIES=5000
NUXT_CACHE_STORAGE_MAX_SIZE_MB=128
# Sortings accepted by the listing and search routes, comma-separated
# (empty = Shopware's standard sortings; add custom sorting keys here)
NUXT_LISTING_SORTINGS=

# Seals the storefront's session cookie (cart, login): at least 32 random
# characters, e.g. `openssl rand -hex 32`. Required in production; keep it
# when you redeploy, or every visitor's cart is gone. To change it, move
# the old one to NUXT_VISITOR_SESSION_PREVIOUS_PASSWORDS (comma-separated).
NUXT_VISITOR_SESSION_PASSWORD=""
# The old password after a change (comma-separated); drop it after
# NUXT_VISITOR_SESSION_MAX_AGE_DAYS (30), cookies are sealed anew on visits.
NUXT_VISITOR_SESSION_PREVIOUS_PASSWORDS=""
NUXT_VISITOR_SESSION_MAX_AGE_DAYS="30"
# Further exact origins (scheme and host) whose pages may change the cart,
# e.g. "https://www.my-shop.example" next to NUXT_PUBLIC_STORE_URL.
NUXT_VISITOR_SESSION_ALLOWED_ORIGINS=""
