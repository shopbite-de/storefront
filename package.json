{
  "name": "@shopbite-de/storefront",
  "version": "1.17.0",
  "main": "nuxt.config.ts",
  "description": "Shopware storefront for food delivery shops",
  "keywords": [
    "shopware",
    "storefront",
    "nuxt",
    "vue",
    "food delivery"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shopbite-de/storefront"
  },
  "author": "@veliu",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:unit": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "pnpm test:bdd",
    "bdd:memory": "SHOPBITE_TEST_SEAMS=1 pnpm build && pnpm test:bdd",
    "bdd:shopware": "test/bdd/run-shopware.sh",
    "test:bdd": "bddgen && NUXT_SHOP_BITE_BACKEND=memory playwright test --project=bdd",
    "test:bdd:mutants": "BDD_MUTANTS=1 bddgen && BDD_MUTANTS=1 NUXT_SHOP_BITE_BACKEND=memory playwright test --project=bdd --retries=0",
    "test:bdd:shopware": "bddgen && NUXT_SHOP_BITE_BACKEND=shopware playwright test --project=bdd",
    "i18n:en": "NUXT_SHOPBITE_LOCALE=en SHOPBITE_TEST_SEAMS=1 pnpm build && pnpm test:i18n:en",
    "test:i18n:en": "NUXT_SHOP_BITE_BACKEND=memory playwright test --project=i18n-en",
    "test:i18n:de": "NUXT_SHOP_BITE_BACKEND=memory playwright test --project=i18n-de",
    "test:a11y": "playwright test --project=a11y --project=a11y-mobile",
    "eslint": "eslint .",
    "eslint:fix": "eslint --fix .",
    "prettier": "prettier --check \"**/*.{ts,tsx,md,vue}\"",
    "prettier:fix": "prettier --check \"**/*.{ts,tsx,md,vue}\" --write",
    "generate-types": "shopware-api-gen generate --apiType=store",
    "load-schema": "pnpx @shopware/api-gen loadSchema --apiType=store",
    "lint:fix": "pnpm run prettier:fix && pnpm run eslint:fix",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@intlify/core-base": "11.4.24",
    "@intlify/message-compiler": "11.4.23",
    "@nuxt/content": "3.17.0",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/image": "^2.2.1",
    "@nuxt/scripts": "1.3.12",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@unhead/vue": "^3.4.3",
    "@vite-pwa/nuxt": "^2.0.1",
    "@vueuse/core": "^15.0.0",
    "defu": "6.1.7",
    "dotenv": "^18.0.10",
    "fflate": "^0.8.3",
    "nuxt": "^4.6.4",
    "nuxt-vitalizer": "4.0.0",
    "reka-ui": "^2.11.0",
    "unstorage": "^1.17.6",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nuxt/devtools-kit": "^3.4.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/hints": "1.1.6",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "^1.65.1",
    "@shopware/api-client": "^1.8.0",
    "@shopware/api-gen": "^1.6.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/ui": "5.1.1",
    "@vue/compiler-dom": "^3.5.45",
    "@vue/server-renderer": "^3.5.45",
    "@vue/test-utils": "^2.6.0",
    "@vue/typescript-plugin": "^3.3.14",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "playwright-bdd": "^9.2.1",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "pnpm@12.21.0"
}
