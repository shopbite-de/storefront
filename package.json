{
  "name": "@shopbite-de/storefront",
  "version": "1.17.0",
  "main": "nuxt.config.ts",
  "description": "Shopware storefront for food delivery shops",
  "keywords": [
    "shopware",
    "storefront",
    "nuxt",
    "vue",
    "food delivery"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shopbite-de/storefront"
  },
  "author": "@veliu",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:unit": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --project=chromium",
    "eslint": "eslint .",
    "eslint:fix": "eslint --fix .",
    "prettier": "prettier --check \"**/*.{ts,tsx,md,vue}\"",
    "prettier:fix": "prettier --check \"**/*.{ts,tsx,md,vue}\" --write",
    "generate-types": "shopware-api-gen generate --apiType=store",
    "load-schema": "pnpx @shopware/api-gen loadSchema --apiType=store",
    "lint:fix": "pnpm run prettier:fix && pnpm run eslint:fix",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@iconify-json/lucide": "^1.2.130",
    "@iconify-json/simple-icons": "^1.2.95",
    "@nuxt/content": "3.16.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "1.3.9",
    "@nuxt/ui": "^4.11.1",
    "@nuxtjs/robots": "^6.2.0",
    "@nuxtjs/sitemap": "^8.5.0",
    "@pinia/nuxt": "1.0.2",
    "@sentry/nuxt": "^10.73.0",
    "@shopware/api-client": "^1.5.1",
    "@shopware/api-gen": "^1.5.1",
    "@shopware/composables": "^1.12.1",
    "@shopware/helpers": "^1.7.2",
    "@shopware/nuxt-module": "^1.5.1",
    "@unhead/vue": "^3.4.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^14.4.0",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "nuxt": "^4.5.2",
    "nuxt-vitalizer": "3.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/hugeicons": "^1.2.34",
    "@nuxt/devtools-kit": "^3.2.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/ui": "5.0.0",
    "@vue/compiler-dom": "^3.5.42",
    "@vue/server-renderer": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "@vue/typescript-plugin": "^3.3.11",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@11.27.0"
}
