{
  "name": "@shopbite-de/storefront",
  "version": "1.17.0",
  "main": "nuxt.config.ts",
  "description": "Shopware storefront for food delivery shops",
  "keywords": [
    "shopware",
    "storefront",
    "nuxt",
    "vue",
    "food delivery"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shopbite-de/storefront"
  },
  "author": "@veliu",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:unit": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --project=chromium",
    "test:a11y": "playwright test --project=a11y --project=a11y-mobile",
    "eslint": "eslint .",
    "eslint:fix": "eslint --fix .",
    "prettier": "prettier --check \"**/*.{ts,tsx,md,vue}\"",
    "prettier:fix": "prettier --check \"**/*.{ts,tsx,md,vue}\" --write",
    "generate-types": "shopware-api-gen generate --apiType=store",
    "load-schema": "pnpx @shopware/api-gen loadSchema --apiType=store",
    "lint:fix": "pnpm run prettier:fix && pnpm run eslint:fix",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/content": "3.16.1",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "1.3.12",
    "@nuxtjs/robots": "^6.2.3",
    "@nuxtjs/sitemap": "^8.5.1",
    "@shopware/api-client": "^1.6.0",
    "@shopware/api-gen": "^1.5.2",
    "@shopware/composables": "^1.13.0",
    "@shopware/helpers": "^1.8.0",
    "@shopware/nuxt-module": "^1.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@unhead/vue": "^3.4.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "dotenv": "^18.0.3",
    "fflate": "^0.8.3",
    "nuxt": "^4.5.2",
    "nuxt-vitalizer": "3.0.0",
    "reka-ui": "^2.10.5",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@nuxt/devtools-kit": "^3.4.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/ui": "5.0.3",
    "@vue/compiler-dom": "^3.5.43",
    "@vue/server-renderer": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "@vue/typescript-plugin": "^3.3.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vue-tsc": "3.3.12"
  },
  "packageManager": "pnpm@12.11.2"
}
